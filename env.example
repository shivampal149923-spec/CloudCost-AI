# Copy this file to .env and fill in your own values. Never commit .env.

# Optional: enables AI-written advice (cloudcost report ... --ai)
ANTHROPIC_API_KEY=

# Optional: override the Claude model used
CLOUDCOST_MODEL=claude-sonnet-5-5

# Future cloud integrations (leave blank until needed)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GOOGLE_APPLICATION_CREDENTIALS=
